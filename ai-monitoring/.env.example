# SecureIQ AI Monitoring Environment Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=false

# Spring Boot Base URL
SPRING_BOOT_API_BASE_URL=http://localhost:8080

# Monitoring Rules & Thresholds
MONITORING_ENABLED=true
FACE_ABSENCE_THRESHOLD_SECONDS=3.0
MULTIPLE_FACE_THRESHOLD_SECONDS=2.0
MIN_FACE_DETECTION_CONFIDENCE=0.5

# Head Pose Thresholds (Degrees)
HEAD_YAW_THRESHOLD=25.0
HEAD_PITCH_UP_THRESHOLD=20.0
HEAD_PITCH_DOWN_THRESHOLD=25.0
LOOK_AWAY_THRESHOLD_SECONDS=3.0

# Eye & Gaze Thresholds
GAZE_HORIZONTAL_THRESHOLD=0.55
GAZE_AWAY_THRESHOLD_SECONDS=3.5

# Cooldown (Seconds)
DETECTION_COOLDOWN_SECONDS=10.0
FRAME_PROCESSING_INTERVAL_MS=1000
